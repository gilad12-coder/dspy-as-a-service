# Skynet on-prem frontend configuration
# Copy to .env.local and replace every change-me value.

# Browser-reachable backend URL. This value is injected at runtime, so one
# frontend image can be promoted between environments without rebuilding.
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://localhost:8000

# Server-side backend URL used only by NextAuth. In Kubernetes this should be
# the in-cluster Service URL while API_URL remains browser-reachable.
BACKEND_INTERNAL_URL=http://localhost:8000

# Public origin used for callbacks and generated metadata.
AUTH_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001
APP_VERSION=0.1.0

# Generate independent values with: openssl rand -base64 48
AUTH_SECRET=change-me
# Must exactly match BACKEND_AUTH_SECRET in backend/.env.
BACKEND_AUTH_SECRET=change-me
BACKEND_AUTH_TOKEN_TTL_SECONDS=900

# ADFS or another OIDC provider. When all three required values are present,
# login leads with SSO. A failed SSO screen exposes the local username fallback;
# /login?local=1 is the break-glass URL. Valid SSO users are auto-provisioned.
# AUTH_SSO_ISSUER=https://adfs.example.internal/adfs
# AUTH_SSO_CLIENT_ID=skynet
# AUTH_SSO_CLIENT_SECRET=change-me
# AUTH_SSO_SCOPE=openid profile email groups
# AUTH_USERNAME_CLAIM=upn
# AUTH_GROUP_CLAIM=groups
# AUTH_ADMIN_GROUPS=Skynet Admins,Platform Ops
# AUTH_ADMINS=break-glass-admin

# Add an internal CA for private OIDC/TLS endpoints when necessary.
# NODE_EXTRA_CA_CERTS=/etc/skynet/ca/internal-ca.pem

# Dictation is hidden unless both this flag and the backend's internal
# TRANSCRIPTION_BASE_URL are configured.
TRANSCRIPTION_ENABLED=false

# Optional product surfaces. Generalist is on in development and off in
# production when unset; tagger assist is on unless explicitly disabled.
# NEXT_PUBLIC_FEATURE_GENERALIST_AGENT=1
# NEXT_PUBLIC_FEATURE_TAGGER_ASSIST=1
