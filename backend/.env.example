# ════════════════════════════════════════════
# Skynet Backend Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Air-gap operators: see AIRGAP.html.
# ════════════════════════════════════════════

# ── LLM gateway (required) ──
# Skynet talks to one OpenAI-compatible endpoint for every LLM call. Point
# OPENAI_API_BASE at it and set OPENAI_API_KEY to whatever token the gateway
# expects (any non-empty string for endpoints that don't authenticate
# per-user). On-prem deployments must use an internal LiteLLM / vLLM /
# Ollama / Azure-on-prem endpoint here — leaving it pointed at api.openai.com
# will fail the moment egress is blocked.
OPENAI_API_BASE=https://llm.your-company.com/v1
OPENAI_API_KEY=replace-me

# ── Public-cloud providers (internet-only, optional) ──
# Uncomment only when running outside an air-gapped environment.
# OpenRouter is the platform's sole LLM provider: the model catalog and the
# shipped agent default (openrouter/openrouter/auto-beta, OpenRouter's Auto
# Router) both require OPENROUTER_API_KEY.
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
#
# ── Dictation speech-to-text ──
# Groq (Whisper large-v3-turbo on LPUs) is the sole STT provider. Unset
# disables composer dictation with a typed 503.
# GROQ_API_KEY=gsk_your-groq-key-here

# ── Database (PostgreSQL, must have pgvector) ──
REMOTE_DB_URL=postgresql://skynet:replace-me@localhost:5432/skynet
# Used by docker-compose to seed the bundled Postgres container. Pick a
# strong value for any non-local stack — compose now requires it explicitly.
POSTGRES_PASSWORD=replace-me

# ── Server ──
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ── Operational alerts (optional) ──
# Forward operational problems (unhandled 500s, a dead worker, a low provider
# balance) to a chat channel so they don't just scroll past in the logs. Set an
# incoming webhook URL to turn alerting on; leave it unset and everything stays
# in the logs only. The payload is Slack's {"text": …} shape, which Mattermost
# and Google Chat also accept.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# ALERT_MIN_LEVEL=ERROR              # min log level forwarded (>= LOG_LEVEL)
# ALERT_ENVIRONMENT=prod             # label prefixed to each alert in a shared channel
# ALERT_THROTTLE_SECONDS=300         # collapse identical alerts within this window (0 = off)

# ── CORS ──
# Comma-separated list of allowed origins (defaults to localhost:3000,3001)
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://yourdomain.com

# ── Worker ──
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL=2.0
WORKER_STALE_THRESHOLD=600
JOB_MAX_ATTEMPTS=3

# ── Database pool ──
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30
DB_PGBOUNCER_TRANSACTION_MODE=false
# Usually set by the Docker build; runtime falls back to `git rev-parse HEAD`.
# SKYNET_CODE_VERSION=

# ── Per-user quota ──
# Default cap for users without a live DB override. Admins can update
# individual users from the settings modal without a backend restart.
MAX_JOBS_PER_USER=100
# Shared with the frontend. Required for backend verification of admin UI calls.
BACKEND_AUTH_SECRET=change-me-in-production
# Prefer IdP groups for admins. ADMIN_USERNAMES is break-glass only.
# ADMIN_GROUPS=Skynet Admins,Platform Ops
# ADMIN_USERNAMES=bob@example.com,ops@example.com
# QUOTA_OVERRIDES={"legacy_power_user":500,"legacy_unlimited":null}

# ── Agent models ──
# Both agents (code agent and generalist agent) default to
# DEFAULT_AGENT_MODEL_ID in core/config.py — OpenRouter's Auto Router
# (openrouter/openrouter/auto-beta), which picks a concrete model per
# request and expects OPENROUTER_API_KEY above.
#
# On-prem: override BOTH the model id (your internal LiteLLM tag) and the
# base URL (your internal OpenAI-compatible gateway) for each agent. The
# OpenRouter default needs egress to openrouter.ai.
# CODE_AGENT_MODEL=openai/your-internal-model
# CODE_AGENT_BASE_URL=https://llm.your-company.com/v1
# GENERALIST_AGENT_MODEL=openai/your-internal-model
# GENERALIST_AGENT_BASE_URL=https://llm.your-company.com/v1

# ── Explore search backend ──
# One knob picks the search engine and the Postgres extension it requires:
#   lexical  (default): vanilla Postgres, no extension, ILIKE substring search.
#   bm25:    needs the pg_search extension (ranked lexical; ILIKE fallback).
#   semantic: needs the pgvector extension + the embedding gateway below.
# SEARCH_BACKEND=lexical

# ── Embedding pipeline (only when SEARCH_BACKEND=semantic) ──
# Each successful job is summarised + embedded; the public /explore scatter
# is the only consumer. Point at an internal OpenAI-compatible embedding API.
# The backend sends POST {EMBEDDINGS_BASE_URL}/embeddings with {model, input}.
# If EMBEDDINGS_API_KEY is unset, OPENAI_API_KEY is reused.
# EMBEDDINGS_BASE_URL=https://llm.your-company.com/v1
# EMBEDDINGS_MODEL=jina-embeddings-v4
# EMBEDDINGS_API_KEY=
# Missing or stale rows are repaired continuously in bounded, advisory-locked
# passes. Increase the interval or lower the batch size if the embedding
# provider has tight rate limits.
# EMBEDDING_INDEX_SWEEP_INTERVAL=60
# EMBEDDING_INDEX_SWEEP_BATCH_SIZE=25

# ── Notifications (internal comms, optional) ──
# Point at internal Rocket.Chat / Mattermost webhook, or leave unset to
# disable notifications entirely.
# COMMS_WEBHOOK_URL=https://chat.yourcompany.com/hooks/your-webhook-id
# COMMS_CHANNEL=#skynet-notifications
# FRONTEND_URL=https://skynet.yourcompany.com

# ── Stripe billing (managed pay-as-you-go credits) ──
# Leave STRIPE_SECRET_KEY unset to run without billing: the wallet reads as a
# free tier and every purchase route returns 503. See docs/stripe-setup.md for
# the full account + dashboard + CLI walkthrough. Use test-mode keys (sk_test_…,
# whsec_…) until you go live. APP_PUBLIC_URL is where Checkout returns the buyer.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# APP_PUBLIC_URL=http://localhost:3000
# Price ids from `python scripts/provision_stripe.py` (or the Stripe dashboard):
# STRIPE_PRICE_PACK_STARTER=price_...
# STRIPE_PRICE_PACK_PLUS=price_...
# STRIPE_PRICE_PACK_PRO=price_...

# ── BYOK key vault ──
# Fernet key (urlsafe base64, 32 bytes) that encrypts stored bring-your-own-key
# provider secrets at rest. Leave unset to disable saving provider keys (the
# vault degrades to read-only; reads of already-stored masked metadata still
# work). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BYOK_VAULT_KEY=

# ── Outbound email (email one-time sign-in codes / email 2FA) ──
# Leave SMTP_HOST unset to disable email-based 2FA (the option hides and any
# send-code call returns a typed "email delivery unavailable" error). Set it to
# an SMTP relay to turn email codes on.
#   Local dev: catch mail with Mailpit — no account, nothing leaves your machine:
#     docker run -d --name skynet-mailpit -p 1025:1025 -p 8025:8025 axllent/mailpit
#     SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_STARTTLS=false; view at :8025.
#   Production: point at a transactional provider (Resend/SendGrid/Mailgun/SES).
#     Typical: SMTP_PORT=587, SMTP_STARTTLS=true, plus SMTP_USERNAME/SMTP_PASSWORD.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=Skynet <no-reply@yourdomain.com>
# SMTP_STARTTLS=true
