# Skynet on-prem backend configuration
# Copy to .env and replace every change-me value.

# PostgreSQL is the only required stateful dependency.
REMOTE_DB_URL=postgresql://skynet:change-me@localhost:5432/skynet
POSTGRES_PASSWORD=change-me

# Shared with the frontend. It signs short-lived browser-to-backend tokens and
# protects the internal local-login/SSO-provisioning endpoints.
BACKEND_AUTH_SECRET=change-me
# Bootstrap and IdP-controlled admins. UI promotions are persisted in Postgres.
ADMIN_USERNAMES=admin
# ADMIN_GROUPS=Skynet Admins,Platform Ops

# Central OpenAI-compatible gateway. Users can also save arbitrary BYOK
# provider connections from Settings. No credit, billing, or licensing checks
# are applied to either path.
OPENAI_API_BASE=https://llm.example.internal/v1
OPENAI_API_KEY=change-me
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# FIREWORKS_AI_API_KEY=
# GROQ_API_KEY=

# Encrypts user-supplied provider secrets at rest. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BYOK_VAULT_KEY=change-me

# Optional internal managed gateway. It is not required; direct central-model
# connections work without it. The bundled LiteLLM example uses PostgreSQL and
# no Redis.
# LITELLM_PROXY_URL=http://litellm-proxy:4000/v1
# LITELLM_PROXY_API_KEY=change-me

API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json
ALLOWED_ORIGINS=http://localhost:3001

# Postgres-backed worker queue. Every API replica can safely claim work through
# leases and SELECT FOR UPDATE SKIP LOCKED; no Redis or external queue is used.
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL=2.0
WORKER_STALE_THRESHOLD=600
JOB_MAX_ATTEMPTS=3
JOB_ADMISSION_MAX_MEMORY_FRACTION=0.85

# Keep the aggregate pool budget below PostgreSQL max_connections across all
# replicas. Enable transaction mode only when the Helm PgBouncer option is used.
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30
DB_PGBOUNCER_TRANSACTION_MODE=false

# Default 250 MiB unified per-user storage allowance. Administrators can set a
# different allowance for each user in Settings > Administration.
USER_STORAGE_QUOTA_BYTES=262144000
DATASET_MAX_FILE_BYTES=52428800

# Explorer is authenticated. Runs start private and appear in the deployment-
# wide public corpus only after their owner explicitly publishes them.
SEARCH_BACKEND=lexical
# SEARCH_BACKEND=semantic
# EMBEDDINGS_BASE_URL=https://embeddings.example.internal/v1
# EMBEDDINGS_MODEL=jina-embeddings-v4
# EMBEDDINGS_API_KEY=
# EMBEDDING_INDEX_SWEEP_INTERVAL=60
# EMBEDDING_INDEX_SWEEP_BATCH_SIZE=25

# Internal agent endpoints. Set both model and base URL for air-gapped use.
# CODE_AGENT_MODEL=openai/internal-model
# CODE_AGENT_BASE_URL=https://llm.example.internal/v1
# GENERALIST_AGENT_MODEL=openai/internal-model
# GENERALIST_AGENT_BASE_URL=https://llm.example.internal/v1
# TAGGER_ASSIST_MODEL=openai/internal-model
# TAGGER_ASSIST_BASE_URL=https://llm.example.internal/v1

# Dictation remains unavailable and hidden until an internal OpenAI-compatible
# transcription endpoint is configured.
# TRANSCRIPTION_BASE_URL=https://speech.example.internal/v1
# TRANSCRIPTION_API_KEY=change-me
# TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# First-party product and decision telemetry is stored in PostgreSQL. Metrics
# are exposed at /metrics and structured logs go to stdout. Every export below
# is opt-in; leaving it unset causes no external telemetry egress.
TELEMETRY_ENABLED=true
# LOG_SHIP_URL=https://logs.example.internal/ingest
# LOG_SHIP_TOKEN=change-me
# ALERT_WEBHOOK_URL=https://chat.example.internal/hooks/skynet
# ALERT_MIN_LEVEL=ERROR
# ALERT_ENVIRONMENT=production
# ALERT_THROTTLE_SECONDS=300
# POSTHOG_PROJECT_API_KEY=
# POSTHOG_HOST=https://posthog.example.internal

# Optional internal SMTP relay for operational notifications.
# SMTP_HOST=smtp.example.internal
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=Skynet <skynet@example.internal>
# SMTP_STARTTLS=true

# Internal model discovery is blocked from RFC1918 addresses by default to
# prevent SSRF. Enable only when authenticated users must discover a trusted
# private gateway.
# DISCOVER_ALLOW_PRIVATE=true

# Usually injected by the image/cluster. Production pods can require it.
# SKYNET_CODE_VERSION=
# REQUIRE_CODE_VERSION=true
