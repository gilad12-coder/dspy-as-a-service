# LiteLLM proxy secrets — copy to .env (gitignored) and fill in.

# The single OpenRouter master account that funds all managed inference.
OPENROUTER_API_KEY=sk-or-...

# Strong admin key for the proxy. Used to mint per-user/per-job virtual keys;
# never handed to the backend directly.
LITELLM_MASTER_KEY=sk-litellm-master-...

# Postgres for the proxy's own virtual-key + spend tables (separate from the
# Skynet application database).
LITELLM_DATABASE_URL=postgresql://litellm:litellm@db:5432/litellm

# Redis for prompt caching (defaults work with the bundled redis service).
REDIS_HOST=redis
REDIS_PORT=6379
# Empty for the bundled local redis (no auth). In a hosted deploy set this to the
# managed Redis password (e.g. Railway's REDISPASSWORD).
REDIS_PASSWORD=
