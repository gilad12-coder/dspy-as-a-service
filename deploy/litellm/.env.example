# LiteLLM proxy secrets — copy to .env (gitignored) and fill in.

# The single OpenRouter master account that funds all managed inference.
OPENROUTER_API_KEY=sk-or-...

# Strong admin key for the proxy; never hand it to browser clients.
LITELLM_MASTER_KEY=sk-litellm-master-...

# PostgreSQL for the proxy's own gateway state. It can share an existing
# PostgreSQL server while using a separate database/schema and credentials.
LITELLM_DATABASE_URL=postgresql://litellm:litellm@db:5432/litellm
